/*
 * userspace/cpp/include/chrono
 * Freestanding <chrono> shim for the vkernel userspace C++ runtime.
 *
 * Implements the subset of std::chrono needed by vkernel userspace apps:
 *   std::chrono::system_clock::now()    -> time_point
 *   time_point - time_point             -> nanoseconds
 *   std::chrono::duration_cast<ms>(ns)  -> milliseconds
 *   duration::count()                   -> int64_t
 *
 * Timing source: vk_tick_count() / vk_ticks_per_sec() from the vkernel API
 * (userspace/include/vk.h, reached via -I../include in every app Makefile).
 */
#pragma once

#include "vk.h"   /* vk_get_api(), vk_u64, vk_u32 */

#include <stdint.h>

namespace std {
namespace chrono {

// ---- Duration types -------------------------------------------------------

struct nanoseconds {
    int64_t count_;
    explicit constexpr nanoseconds(int64_t c = 0) noexcept : count_(c) {}
    constexpr int64_t count() const noexcept { return count_; }
};

struct milliseconds {
    int64_t count_;
    explicit constexpr milliseconds(int64_t c = 0) noexcept : count_(c) {}
    constexpr int64_t count() const noexcept { return count_; }
};

// ---- duration_cast --------------------------------------------------------

template <typename To, typename From>
inline To duration_cast(const From&) = delete;

template <>
inline milliseconds duration_cast<milliseconds, nanoseconds>(const nanoseconds& ns)
{
    return milliseconds(ns.count_ / 1'000'000LL);
}

// ---- time_point -----------------------------------------------------------

class time_point {
    int64_t ns_;

public:
    constexpr time_point() noexcept : ns_(0) {}
    explicit constexpr time_point(int64_t ns) noexcept : ns_(ns) {}

    nanoseconds operator-(const time_point& other) const noexcept
    {
        return nanoseconds(ns_ - other.ns_);
    }
};

// ---- system_clock ---------------------------------------------------------

struct system_clock {
    using time_point = ::std::chrono::time_point;

    static time_point now() noexcept
    {
        const vk_api_t* api = vk_get_api();
        vk_u64          ticks = api->vk_tick_count();
        vk_u32          tps   = api->vk_ticks_per_sec();
        if (tps == 0) tps = 1000;

        /* Convert ticks -> nanoseconds */
        int64_t ns = (int64_t)ticks * 1'000'000'000LL / (int64_t)tps;
        return time_point(ns);
    }
};

} // namespace chrono
} // namespace std

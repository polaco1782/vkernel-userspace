#ifndef VKCPP_ALGORITHM_H
#define VKCPP_ALGORITHM_H

#include <utility>

namespace std {

template <typename T>
struct less {
    constexpr bool operator()(const T& lhs, const T& rhs) const
    {
        return lhs < rhs;
    }
};

template <typename Iterator, typename T>
void fill(Iterator first, Iterator last, const T& value)
{
    while (first != last) {
        *first = value;
        ++first;
    }
}

template <typename T>
constexpr const T& min(const T& lhs, const T& rhs)
{
    return rhs < lhs ? rhs : lhs;
}

template <typename T>
constexpr const T& max(const T& lhs, const T& rhs)
{
    return lhs < rhs ? rhs : lhs;
}

template <typename Iterator, typename T, typename Compare>
Iterator lower_bound(Iterator first, Iterator last, const T& value, Compare compare)
{
    using diff_t = long long;
    diff_t count = static_cast<diff_t>(last - first);
    while (count > 0) {
        const diff_t step = count / 2;
        Iterator it = first + step;
        if (compare(*it, value)) {
            first = ++it;
            count -= step + 1;
        } else {
            count = step;
        }
    }
    return first;
}

template <typename Iterator, typename Compare>
void sort(Iterator first, Iterator last, Compare compare)
{
    for (Iterator it = first; it != last; ++it) {
        Iterator best = it;
        for (Iterator current = it + 1; current != last; ++current) {
            if (compare(*current, *best)) {
                best = current;
            }
        }
        if (best != it) {
            std::swap(*it, *best);
        }
    }
}

template <typename Iterator>
void sort(Iterator first, Iterator last)
{
    sort(first, last, [](const auto& lhs, const auto& rhs) { return lhs < rhs; });
}

template <typename Iterator>
Iterator unique(Iterator first, Iterator last)
{
    if (first == last) {
        return last;
    }

    Iterator result = first;
    for (Iterator current = first + 1; current != last; ++current) {
        if (!(*result == *current)) {
            ++result;
            if (result != current) {
                *result = std::move(*current);
            }
        }
    }

    return ++result;
}

}  // namespace std

#endif  // VKCPP_ALGORITHM_H
